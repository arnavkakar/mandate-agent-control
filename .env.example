# Railway PostgreSQL supplies DATABASE_URL when the database service is linked.
DATABASE_URL=postgresql://mandate:mandate@localhost:5432/mandate
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
NEXT_PUBLIC_MANDATE_API_URL=http://localhost:3001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_INTERPRETATIONS_PER_HOUR=10
MANDATE_MAX_MONTHLY_BUDGET_CENTS=10000000
MANDATE_MAX_TRANSACTION_CENTS=1000000
GOOGLE_CLIENT_ID=
